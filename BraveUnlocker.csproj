<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BraveUnlocker</RootNamespace>
    <AssemblyName>BraveOriginUnlocker</AssemblyName>

    <!-- Optimization and NativeAOT configuration -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- Assembly metadata, helps AV engines identify the binary as legitimate -->
    <Product>Brave Origin Unlocker</Product>
    <Company>Brave Origin Unlocker Tools</Company>
    <Authors>kaif-00z, ObjectAscended</Authors>
    <Description>Unlocks Brave Origin browser features by modifying local state configuration.</Description>
    <Copyright>Copyright (c) kaif-00z &amp; ObjectAscended 2026</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <!-- Embed application manifest for Windows trust signals -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
